# ==============================================================================
# AgriVision Environment Configuration Template
# Copy this file to .env and configure values for local or cloud deployment
# ==============================================================================

# Frontend Port & Host
VITE_PORT=5173
VITE_APP_TITLE=AgriVision AI
VITE_API_BASE_URL=http://localhost:8000

# Backend FastAPI Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Machine Learning & Vision Model Configuration
MODEL_CHECKPOINT_PATH=./ml_models/crop_pathology_resnet50.pt
YOLO_WEIGHTS_PATH=./ml_models/yolov8_foliar_lesion.pt
CONFIDENCE_THRESHOLD=0.75
ENABLE_CUDA_ACCELERATION=false
